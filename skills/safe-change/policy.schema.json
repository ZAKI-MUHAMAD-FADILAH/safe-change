{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackpratamaa/safe-change/schemas/skill-policy-v1.json",
  "title": "safe-change Installed Skill Manifest Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyVersion",
    "canonicalSha256",
    "profileSha256",
    "composedSha256",
    "agentProfile"
  ],
  "properties": {
    "policyVersion": {
      "const": 1
    },
    "canonicalSha256": {
      "$ref": "#/$defs/sha256"
    },
    "profileSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "composedSha256": {
      "$ref": "#/$defs/sha256"
    },
    "agentProfile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
