{
  "version": 1,
  "checks": [
    {
      "name": "build",
      "executable": "npm",
      "args": ["run", "build"],
      "timeout": 60
    },
    {
      "name": "test",
      "executable": "npx",
      "args": ["vitest", "run"],
      "timeout": 120
    },
    {
      "name": "coverage",
      "executable": "npm",
      "args": ["run", "test:coverage"],
      "timeout": 180
    },
    {
      "name": "dependency-audit",
      "executable": "npm",
      "args": ["audit", "--audit-level=high"],
      "timeout": 120
    }
  ],
  "enterprisePolicy": {
    "policyVersion": 1,
    "minimumMode": "high-assurance",
    "requireBaseline": true,
    "requireTests": true,
    "requireCoverage": true,
    "requireDependencyAudit": true,
    "requireDiffReview": true,
    "allowForcePush": false,
    "allowDestructiveGit": false,
    "changeBudget": {
      "maxFilesChanged": 20,
      "maxLinesAdded": 1500,
      "maxLinesDeleted": 500,
      "maxPublicApisChanged": 20,
      "maxDeletedFiles": 0,
      "allowLockfileChanges": false
    }
  }
}
