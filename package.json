{
  "name": "safe-change",
  "version": "0.1.0",
  "description": "A local-first safety net for AI-assisted coding. Records baselines, detects regressions, and helps investigate changes without silently altering your work.",
  "type": "module",
  "bin": {
    "safe-change": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZAKI-MUHAMAD-FADILAH/safe-change.git"
  },
  "bugs": {
    "url": "https://github.com/ZAKI-MUHAMAD-FADILAH/safe-change/issues"
  },
  "homepage": "https://github.com/ZAKI-MUHAMAD-FADILAH/safe-change#readme",
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "LICENSE_CHANGE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "ai",
    "coding-agent",
    "safety",
    "baseline",
    "regression",
    "git",
    "cli",
    "vibe-coding",
    "cursor",
    "claude-code",
    "codex",
    "antigravity",
    "developer-tools",
    "safe-change",
    "agpl-3-0",
    "typescript"
  ],
  "author": "ZACK.PRATAMA PT ZYNTRIX ARTIFICIAL INTELIGENCE INDONESIA (SAFE-CHANGE)",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0"
  }
}
